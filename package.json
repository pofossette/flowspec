{
  "name": "flowspec-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter flowspec dev",
    "dev:web": "pnpm --filter @flowspec/web-app dev",
    "dev:cli": "pnpm --filter flowspec dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @flowspec/domain test && pnpm --filter @flowspec/parser test && pnpm --filter @flowspec/registry test && pnpm --filter @flowspec/lock test && pnpm --filter flowspec test",
    "cli": "pnpm --filter flowspec exec node ./dist/run.js",
    "cli:dev": "pnpm --filter flowspec dev",
    "serve": "pnpm --filter flowspec exec node ./dist/run.js flow serve",
    "serve:dev": "pnpm --filter flowspec dev flow serve",
    "preview:build": "pnpm --filter @flowspec/web-app build",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code --format json --quiet",
    "fallow:health": "fallow health",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit --base main",
    "fallow:check": "fallow dead-code || true",
    "jscpd": "jscpd --config .jscpd.json packages apps",
    "jscpd:report": "jscpd --config .jscpd.json --reporters console,html --output .jscpd-report packages apps",
    "check": "pnpm typecheck && pnpm lint && pnpm jscpd",
    "check:full": "pnpm typecheck && pnpm lint && pnpm fallow:check && pnpm jscpd",
    "quality": "pnpm typecheck && pnpm lint && pnpm fallow || true",
    "prepare:hooks": "fallow hooks install --target git || true",
    "test:e2e": "pnpm -r build && pnpm exec playwright test",
    "test:e2e:ci": "pnpm -r build && pnpm exec playwright test --reporter=html,list --project=chromium",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:debug": "pnpm exec playwright test --debug",
    "test:e2e:report": "pnpm exec playwright show-report",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "prepare": "husky && pnpm run prepare:hooks || true",
    "format:prettier": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "fallow": "3.20.0",
    "husky": "^9.1.7",
    "jscpd": "5.1.0",
    "lint-staged": "^17.4.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "biome check --write --unsafe --no-errors-on-unmatched"
    ],
    "*.{json,jsonc,css,md}": [
      "prettier --write --ignore-unknown",
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
