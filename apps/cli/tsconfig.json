{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "noUnusedLocals": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/parser"
    },
    {
      "path": "../../packages/lock"
    },
    {
      "path": "../../packages/registry"
    },
    {
      "path": "../../packages/server"
    },
    {
      "path": "../../packages/web"
    },
    {
      "path": "../../packages/ai"
    }
  ]
}
